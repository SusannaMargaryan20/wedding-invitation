# The only required Netlify Environment Variable.
# Create it in Resend Dashboard -> API Keys, then add it in Netlify.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Required when sending RSVP messages to arbitrary Gmail addresses.
# Verify the domain in Resend first, then use an address on that domain.
# Example: Wedding RSVP <rsvp@yourdomain.com>
RESEND_FROM_EMAIL=Wedding RSVP <rsvp@yourdomain.com>
